# Same Firebase web app configuration as chaicart-live. These fields are browser-visible.
AUTH_MODE=firebase
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# Backend-only credential file, outside source control. Prefer workload identity when available.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/private/path/service-account.json
# Azure alternative: a Key Vault reference resolving to service-account JSON.
# Set this in App Service settings, not in source or frontend configuration.
# FIREBASE_SERVICE_ACCOUNT_JSON=@Microsoft.KeyVault(SecretUri=https://VAULT.vault.azure.net/secrets/firebase-service-account/)
DATA_DIR=data
PORT=8080
